# Copy to `.env` and fill in. `.env` is gitignored -- never commit it.
#
# Create a long-lived access token in Home Assistant:
#   Profile (bottom-left avatar) -> Security -> Long-lived access tokens -> Create token

HA_URL=https://homeassistant.local:8123
HA_TOKEN=

# Bluetooth MAC of the bed controller. Find it with:
#   python3 tools/ble_probe.py scan
# On macOS this is a CoreBluetooth UUID, not a real MAC; on Linux/HA it is a MAC.
BED_ADDRESS=

# Set to false only if your HA instance uses a self-signed certificate.
HA_VERIFY_SSL=true
